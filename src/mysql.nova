// mysql.nova — the MySQL/MariaDB driver, implementing the `db` seam (db.Connection /
// db.Driver) over the MySQL client/server protocol. Extracted from the PostgreSQL
// reference driver, adapted to MySQL's very different wire:
//   - packets are [payload_len:u24 LE][sequence_id:u8][payload] (not [type][len BE]);
//   - integers/strings are LENGTH-ENCODED (lenenc), not fixed-width;
//   - a Handshake/HandshakeResponse exchange with salt-based auth (mysql_native_password
//     = SHA1 scramble; caching_sha2_password fast path = SHA256 scramble — both computed in
//     the runtime, golden-verified against python hashlib);
//   - result sets are: column_count, N column-definition packets, EOF, row packets, EOF.
//
//   let drv = MyDriver();
//   let conn = drv.connect("mysql://user:pass@127.0.0.1:3306/mydb");
//   let rs = conn.query("SELECT id, name FROM users", List<DbValue>());
//
// The wire CODEC (framing, lenenc, packet decode) is pure over byte buffers and gated
// offline; the auth scramble is golden-verified. NOTE: not yet live-verified end-to-end (no
// MySQL server was available) — the connect/query flow follows the spec but is unproven live.
import net.aio;
import net.asynctls;
import io.file;
import bytes;
import string;
import list;
import db;
import crypto.hash.sha;
import crypto.rsa;

// MySQL auth-response scrambles, in pure Nova over the crypto/hash primitives (no runtime shim).
// These are protocol-specific obfuscations (NOT general cryptography):
//
//   native: SHA1(pw) XOR SHA1(salt ++ SHA1(SHA1(pw)))          (20 raw bytes)
//   sha2:   SHA256(pw) XOR SHA256(SHA256(SHA256(pw)) ++ salt)  (32 raw bytes)
//
// `salt` is the server's scramble; the result is binary (may contain NULs).
// Public so the driver's codec gate can golden-verify them; not general crypto.
fn catBytes(a: string, b: string): string {
    let out = bytes.alloc(a.length + b.length);
    let i = 0;
    while (i < a.length) { bytes.write_byte(out, i, bytes.read_byte(a as ptr, i)); i = i + 1; }
    let j = 0;
    while (j < b.length) { bytes.write_byte(out, a.length + j, bytes.read_byte(b as ptr, j)); j = j + 1; }
    return out as string;
}

pub fn mysqlNativeScramble(password: string, salt: string): string {
    let stage1 = sha.sha1Raw(password);                 // SHA1(pw)
    let stage2 = sha.sha1Raw(stage1);                   // SHA1(SHA1(pw))
    let seed = sha.sha1Raw(catBytes(salt, stage2));     // SHA1(salt ++ stage2)
    let out = bytes.alloc(20);
    let i = 0;
    while (i < 20) { bytes.write_byte(out, i, bytes.read_byte(stage1 as ptr, i) ^ bytes.read_byte(seed as ptr, i)); i = i + 1; }
    return out as string;
}

pub fn mysqlSha2Scramble(password: string, salt: string): string {
    let stage1 = sha.sha256Raw(password);               // SHA256(pw)
    let stage2 = sha.sha256Raw(stage1);                 // SHA256(SHA256(pw))
    let seed = sha.sha256Raw(catBytes(stage2, salt));   // SHA256(stage2 ++ salt)
    let out = bytes.alloc(32);
    let i = 0;
    while (i < 32) { bytes.write_byte(out, i, bytes.read_byte(stage1 as ptr, i) ^ bytes.read_byte(seed as ptr, i)); i = i + 1; }
    return out as string;
}

// T14 Feature 2: caching_sha2_password fast-auth scramble, exposed under its protocol name.
//   token = SHA256(pw) XOR SHA256( SHA256(SHA256(pw)) ++ nonce )   (32 raw bytes)
// This is exactly `mysqlSha2Scramble` (the wire driver's spelling); it is provided as a pure,
// golden/round-trip-testable entry point. sha256_password uses the same fast-auth scramble.
pub fn cachingSha2Scramble(password: string, nonce: string): string {
    return mysqlSha2Scramble(password, nonce);
}

// D6: caching_sha2_password FULL auth (uncached password over a plaintext channel). The client
// obfuscates the password by XOR-ing (password + a trailing NUL) with the 20-byte server nonce
// cyclically, then RSA-OAEP-encrypts that under the server's RSA public key (PEM). Returns the
// ciphertext (RSA-modulus-sized raw bytes).
fn rsaEncryptPassword(password: string, salt: string, pem: string): string {
    let n = password.length + 1;              // include the trailing NUL byte
    let buf = bytes.alloc(n);
    let i = 0;
    while (i < n) {
        let pc = if (i < password.length) bytes.read_byte(password, i) else 0;
        let sc = bytes.read_byte(salt, i % salt.length);
        bytes.write_byte(buf, i, pc ^ sc);
        i = i + 1;
    }
    let xored = buf as string;                 // length-n Nova string (may contain NULs)
    return rsa.oaepEncryptSha1(pem, xored, n);
}

// --- Capability flags (client) ------------------------------------------------
// LONG_PASSWORD(1) | CONNECT_WITH_DB(8) | PROTOCOL_41(0x200) | TRANSACTIONS(0x2000)
// | SECURE_CONNECTION(0x8000) | PLUGIN_AUTH(0x80000)
fn clientCapabilities(): int { return 1 + 8 + 512 + 8192 + 32768 + 524288; }

// --- MySQL column type codes -> seam DbType -----------------------------------
fn typeToDbType(t: int): DbType {
    if (t == 1) { return DbType.Int4; }    // TINY
    if (t == 2) { return DbType.Int4; }    // SHORT
    if (t == 3) { return DbType.Int4; }    // LONG
    if (t == 9) { return DbType.Int4; }    // INT24
    if (t == 8) { return DbType.Int8; }    // LONGLONG
    if (t == 4) { return DbType.Float4; }  // FLOAT
    if (t == 5) { return DbType.Float8; }  // DOUBLE
    if (t == 0) { return DbType.Decimal; }   // DECIMAL
    if (t == 246) { return DbType.Decimal; } // NEWDECIMAL
    if (t == 7) { return DbType.Timestamp; }  // TIMESTAMP
    if (t == 12) { return DbType.Timestamp; } // DATETIME
    if (t == 252) { return DbType.Blob; }  // BLOB
    // VARCHAR(15) / VAR_STRING(253) / STRING(254) / anything else -> Text
    return DbType.Text;
}

// --- Little-endian + lenenc writers -------------------------------------------
fn u8b(v: int): string { let p = bytes.alloc(1); bytes.write_byte(p, 0, v % 256); return p as string; }
fn u16le(v: int): string {
    let p = bytes.alloc(2);
    bytes.write_byte(p, 0, v % 256);
    bytes.write_byte(p, 1, (v / 256) % 256);
    return p as string;
}
fn u24le(v: int): string {
    let p = bytes.alloc(3);
    bytes.write_byte(p, 0, v % 256);
    bytes.write_byte(p, 1, (v / 256) % 256);
    bytes.write_byte(p, 2, (v / 65536) % 256);
    return p as string;
}
fn u32le(v: int): string {
    let p = bytes.alloc(4);
    bytes.write_byte(p, 0, v % 256);
    bytes.write_byte(p, 1, (v / 256) % 256);
    bytes.write_byte(p, 2, (v / 65536) % 256);
    bytes.write_byte(p, 3, (v / 16777216) % 256);
    return p as string;
}
fn cstr(s: string): string { return s + u8b(0); }
// lenenc string: a length-encoded-int length + the bytes (v1 handles the < 251 length only,
// which covers usernames and auth responses; larger payloads would use the 0xfc/fd/fe forms).
fn lenencStr(s: string): string { return u8b(s.length) + s; }
fn zeros(n: int): string {
    let p = bytes.alloc(n);
    let i = 0;
    while (i < n) { bytes.write_byte(p, i, 0); i = i + 1; }
    return p as string;
}

// A MySQL packet: [payload_len:u24 LE][seq:u8][payload].
fn packet(seq: int, payload: string): string {
    return u24le(payload.length) + u8b(seq) + payload;
}

// T14 Feature 1: multi-packet (>=16MB) reassembly.
// MySQL splits a payload of length >= 0xFFFFFF across packets: a packet whose length == 0xFFFFFF is a
// CONTINUATION marker whose successor continues the SAME logical payload; the run ends at the first
// packet with length < 0xFFFFFF (which may be 0). This PURE helper joins a CONTIGUOUS buffer of framed
// packets ([u24 len LE][seq][body]...) starting at `off` into the full logical payload. readPacket
// applies the identical continuation rule over the streaming socket reader (see below); this helper
// is the offline-gated single source of truth for the join rule.
pub const MYSQL_MAX_PACKET: int = 16777215;   // 0xFFFFFF
pub fn reassemblePayload(buf: string, off: int): string {
    let out = "";
    let p = off;
    while (true) {
        let a = bytes.read_byte(buf as ptr, p);
        let b = bytes.read_byte(buf as ptr, p + 1);
        let c = bytes.read_byte(buf as ptr, p + 2);
        let plen = a + b * 256 + c * 65536;
        p = p + 4;                       // skip the 3-byte length + 1-byte sequence id
        out = out + string.slice(buf, p, p + plen);
        p = p + plen;
        if (plen < MYSQL_MAX_PACKET) { return out; }
    }
    return out;
}

/// COM_QUERY (0x03) + SQL. Sequence id resets to 0 for a new command.
pub fn buildComQuery(sql: string): string {
    return packet(0, u8b(3) + sql);
}

/// HandshakeResponse41: capabilities, max-packet, charset, 23 filler, user, auth response
/// (lenenc byte + scramble), database, auth-plugin-name. Sequence id 1 (server handshake = 0).
// CLIENT_SSL capability flag. Set (alongside the base flags) when the client will run the TLS
// handshake between the server Handshake and the HandshakeResponse (STARTTLS).
const CLIENT_SSL: int = 2048;

pub fn buildHandshakeResponse(user: string, database: string, scramble: string, plugin: string): string {
    return buildHandshakeResponseFull(user, database, scramble, plugin, clientCapabilities(), 1);
}

// Caps/seq-parameterized HandshakeResponse41. The TLS path sends this with caps | CLIENT_SSL at seq 2
// (the SSLRequest took seq 1); the plaintext path uses the base caps at seq 1.
pub fn buildHandshakeResponseFull(user: string, database: string, scramble: string, plugin: string, caps: int, seq: int): string {
    let body = u32le(caps)
        + u32le(16777216)         // max packet 16MB
        + u8b(45)                 // charset utf8mb4_general_ci
        + zeros(23)
        + cstr(user)
        + lenencStr(scramble)     // SECURE_CONNECTION: 1-byte length + scramble
        + cstr(database)
        + cstr(plugin);
    return packet(seq, body);
}

// SSLRequest: the first 32 bytes of a HandshakeResponse41 (caps incl CLIENT_SSL, max-packet, charset,
// 23 filler) and nothing else. Sent at seq 1; the TLS handshake then runs on the socket.
pub fn buildSSLRequest(caps: int, seq: int): string {
    let body = u32le(caps) + u32le(16777216) + u8b(45) + zeros(23);
    return packet(seq, body);
}

// --- Payload cursor (decode, pure over a byte-buffer string) ------------------
struct MyCursor {
    pub s: string,
    pub pos: int,
    init(s: string) { self.s = s; self.pos = 0; }

    pub fn byte(self: MyCursor): int {
        let b = self.s[self.pos];
        self.pos = self.pos + 1;
        return b;
    }
    pub fn u16(self: MyCursor): int {
        let a = self.byte();
        let b = self.byte();
        return a + b * 256;
    }
    pub fn u32(self: MyCursor): int {
        let a = self.byte();
        let b = self.byte();
        let c = self.byte();
        let d = self.byte();
        return a + b * 256 + c * 65536 + d * 16777216;
    }
    // length-encoded integer.
    pub fn lenenc(self: MyCursor): int {
        let first = self.byte();
        if (first < 251) { return first; }
        if (first == 252) { return self.u16(); }
        if (first == 253) {
            let a = self.byte(); let b = self.byte(); let c = self.byte();
            return a + b * 256 + c * 65536;
        }
        // 254: 8-byte LE.
        let v = 0; let mul = 1; let i = 0;
        while (i < 8) { v = v + self.byte() * mul; mul = mul * 256; i = i + 1; }
        return v;
    }
    pub fn take(self: MyCursor, n: int): string {
        let out = string.slice(self.s, self.pos, self.pos + n);
        self.pos = self.pos + n;
        return out;
    }
    // length-encoded string.
    pub fn lenencStr(self: MyCursor): string {
        let n = self.lenenc();
        return self.take(n);
    }
    pub fn cstr(self: MyCursor): string {
        let start = self.pos;
        while (self.s[self.pos] != 0) { self.pos = self.pos + 1; }
        let out = string.slice(self.s, start, self.pos);
        self.pos = self.pos + 1;
        return out;
    }
    pub fn skip(self: MyCursor, n: int): void { self.pos = self.pos + n; }
    pub fn remaining(self: MyCursor): int { return self.s.length - self.pos; }
}

/// The server Handshake (protocol v10): version, server-version(cstr), conn-id(u32),
/// auth-data-1(8), filler, cap-low(u16), charset(u8), status(u16), cap-high(u16),
/// auth-data-len(u8), reserved(10), auth-data-2, auth-plugin-name(cstr). Returns the 20-byte
/// salt (data1 ++ data2, trimmed) + the plugin name.
struct Handshake {
    pub salt: string,
    pub plugin: string,
    init(salt: string, plugin: string) { self.salt = salt; self.plugin = plugin; }
}
pub fn parseHandshake(payload: string): Handshake {
    let c = MyCursor(payload);
    c.skip(1);            // protocol version (10)
    let sv = c.cstr();    // server version
    c.skip(4);            // connection id
    let salt1 = c.take(8);
    c.skip(1);            // filler 0
    c.skip(2);            // capability flags lower
    c.skip(1);            // character set
    c.skip(2);            // status flags
    c.skip(2);            // capability flags upper
    let authLen = c.byte();  // length of auth-plugin-data
    c.skip(10);           // reserved
    // auth-data part 2: max(13, authLen - 8) bytes, but the last byte is a NUL — take 12.
    let part2len = 12;
    if (authLen > 21) { part2len = authLen - 8 - 1; }
    let salt2 = c.take(part2len);
    let plugin = "mysql_native_password";
    if (c.remaining() > 0) { plugin = c.cstr(); }
    return Handshake(salt1 + salt2, plugin);
}

// --- Result decoders ----------------------------------------------------------

/// Column Definition (v41): catalog/schema/table/org_table/name/org_name (lenenc-str each),
/// then a fixed block: len-of-fixed(lenenc,=0x0c), charset(u16), col_len(u32), type(u8),
/// flags(u16), decimals(u8), filler(u16). We keep name + type -> typed Column.
pub fn decodeColumnDef(payload: string): Column {
    let c = MyCursor(payload);
    c.lenencStr();        // catalog "def"
    c.lenencStr();        // schema
    c.lenencStr();        // table
    c.lenencStr();        // org_table
    let name = c.lenencStr();
    c.lenencStr();        // org_name
    c.lenenc();           // length of fixed-length fields (0x0c)
    c.skip(2);            // charset
    c.skip(4);            // column length
    let t = c.byte();     // column type
    return Column(name, typeToDbType(t));
}

fn decodeCell(t: DbType, raw: string, isNull: bool): DbValue {
    if (isNull) { return db.dbNull(); }
    if (t == DbType.Bool) {
        return db.dbBool(string.eql(raw, "1") || string.eql(raw, "t") || string.eql(raw, "true"));
    }
    if (t == DbType.Int4 || t == DbType.Uint4) { return db.dbInt(string.parseI64(raw)); }
    if (t == DbType.Int8 || t == DbType.Uint8) { return db.dbLong(string.parseI64(raw)); }
    // Temporal (text protocol) arrives as "YYYY-MM-DD HH:MM:SS"; keep it verbatim. The old code grouped
    // it with Int8 and ran parseI64, which returned just the leading year -> garbage.
    if (t == DbType.Timestamp) { return db.dbTimestamp(raw); }
    if (t == DbType.Float4 || t == DbType.Float8) { return db.dbDouble(string.parseFloat(raw)); }
    if (t == DbType.Decimal) { return DbValue(DbType.Decimal, 0, 0.0, decimal.fromString(raw), raw); } // S4: exact .dec
    return db.dbText(raw);
}

/// A text-protocol result row: for each column, a lenenc-str, or 0xfb = NULL.
pub fn decodeTextRow(payload: string, cols: List<Column>): Row {
    let row = Row();
    let c = MyCursor(payload);
    let n = cols.size();
    let i = 0;
    while (i < n) {
        let col = cols.get(i) ?? Column("", DbType.Text);
        let marker = c.byte();
        if (marker == 251) {                 // 0xfb = NULL
            row.cells.push(decodeCell(col.type_oid, "", true));
        } else {
            // `marker` is the first byte of the value's lenenc length; decode the rest.
            let len = marker;
            if (marker == 252) { len = c.u16(); }
            else if (marker == 253) { let a = c.byte(); let b = c.byte(); let cc = c.byte(); len = a + b * 256 + cc * 65536; }
            else if (marker == 254) { len = 0; let mul = 1; let k = 0; while (k < 8) { len = len + c.byte() * mul; mul = mul * 256; k = k + 1; } }
            row.cells.push(decodeCell(col.type_oid, c.take(len), false));
        }
        i = i + 1;
    }
    return row;
}

// ============================================================================
// D6: server-side prepared statements — the MySQL binary protocol (COM_STMT_*).
// ============================================================================

// A prepared statement: server statement id, SQL (for the dedup cache), the result columns +
// their RAW MySQL type bytes (the binary row decoder needs the exact wire type, which the seam
// DbType loses — TINY/SHORT/LONG all map to Int4), and the parameter count.
struct MyStmt {
    pub id: int,
    pub sql: string,
    pub cols: List<Column>,
    pub colTypes: List<int>,   // raw MySQL type | (unsigned ? 256 : 0)
    pub numParams: int,
    init(id: int, sql: string, cols: List<Column>, colTypes: List<int>, numParams: int) {
        self.id = id; self.sql = sql; self.cols = cols; self.colTypes = colTypes; self.numParams = numParams;
    }
}

// The raw MySQL column type byte plus its UNSIGNED flag, packed as `type | (unsigned<<8)`. Reads
// the same column-definition packet as decodeColumnDef but keeps the wire type (+ flags), which
// the binary protocol needs to size each value.
fn columnTypeRaw(payload: string): int {
    let c = MyCursor(payload);
    c.lenencStr(); c.lenencStr(); c.lenencStr(); c.lenencStr(); c.lenencStr(); c.lenencStr(); // strings
    c.lenenc();           // 0x0c
    c.skip(2);            // charset
    c.skip(4);            // column length
    let t = c.byte();     // type
    let flags = c.u16();  // flags — UNSIGNED_FLAG = 0x20 (32)
    let uns = if ((flags / 32) % 2 == 1) 256 else 0;
    return t + uns;
}

// lenenc integer (full: <251 one byte, else 0xfc/0xfd/0xfe forms).
fn lenencInt(v: int): string {
    if (v < 251) { return u8b(v); }
    if (v < 65536) { return u8b(252) + u8b(v % 256) + u8b((v / 256) % 256); }
    if (v < 16777216) { return u8b(253) + u24le(v); }
    return u8b(254) + u32le(v) + u32le(0);
}
fn lenencStrFull(s: string): string { return lenencInt(s.length) + s; }

// A bound parameter's value as TEXT (the driver sends every param as MYSQL_TYPE_VAR_STRING and
// lets the server coerce to the column type — the binary analogue of PG's text-format Bind).
fn valueToBindText(v: DbValue): string {
    if (v.kind == DbType.Bool) { if (v.asBool()) { return "1"; } return "0"; }
    if (v.kind == DbType.Text || v.kind == DbType.Blob) { return v.asText(); }
    if (v.kind == DbType.Decimal) { return v.asText(); }
    if (v.kind == DbType.Float4 || v.kind == DbType.Float8) { let d = v.asDouble(); return `${d}`; }
    let iv = v.asLong();
    return `${iv}`;
}

// COM_STMT_PREPARE (0x16) + SQL.
pub fn buildStmtPrepare(sql: string): string { return packet(0, u8b(22) + sql); }
// COM_STMT_CLOSE (0x19) + statement id.
fn buildStmtClose(stmtId: int): string { return packet(0, u8b(25) + u32le(stmtId)); }

// COM_STMT_EXECUTE (0x17): stmt_id, flags=0 (no cursor), iteration_count=1, then — if there are
// params — the NULL bitmap, new-params-bound=1, each param's type (VAR_STRING), then each
// non-null param value as a lenenc string.
pub fn buildStmtExecute(stmtId: int, params: List<DbValue>): string {
    let np = params.size();
    let body = u8b(23) + u32le(stmtId) + u8b(0) + u32le(1);
    if (np > 0) {
        let nbytes = (np + 7) / 8;
        let nullmap = bytes.alloc(nbytes);
        let k = 0;
        while (k < nbytes) { bytes.write_byte(nullmap, k, 0); k = k + 1; }
        let i = 0;
        while (i < np) {
            let p = params.get(i) ?? db.dbNull();
            if (p.isNull()) {
                let cur = bytes.read_byte(nullmap, i / 8);
                bytes.write_byte(nullmap, i / 8, cur | (1 << (i % 8)));
            }
            i = i + 1;
        }
        let nmStr = nullmap as string;                 // owned local so the buffer is freed (not leaked)
        body = body + nmStr + u8b(1);                  // bitmap + new_params_bound_flag
        i = 0;
        while (i < np) { body = body + u8b(253) + u8b(0); i = i + 1; }   // all params VAR_STRING
        i = 0;
        while (i < np) {
            let p = params.get(i) ?? db.dbNull();
            if (!p.isNull()) { body = body + lenencStrFull(valueToBindText(p)); }
            i = i + 1;
        }
    }
    return packet(0, body);
}

// Read `n` little-endian bytes into a 64-bit value.
fn readLE(c: MyCursor, n: int): long {
    let v: long = 0;
    let mul: long = 1;
    let i = 0;
    while (i < n) { v = v + (c.byte() as long) * mul; mul = mul * 256; i = i + 1; }
    return v;
}
// Two's-complement sign-extend a `width`-byte unsigned value.
fn signExtend(v: long, width: int): long {
    let bits: long = (width as long) * 8;
    let half: long = 1;
    let i = 0;
    while (i < bits - 1) { half = half * 2; i = i + 1; }   // 2^(bits-1)
    if (v >= half) { return v - half - half; }
    return v;
}

// Decode ONE binary-protocol value for a column of raw type `tf` (type | unsigned<<8).
fn decodeBinaryCell(c: MyCursor, tf: int): DbValue {
    let t = tf % 256;
    let uns = tf >= 256;
    if (t == 1) {                                   // TINY (1 byte)
        let v = readLE(c, 1);
        return db.dbInt((if (uns) v else signExtend(v, 1)) as int);
    }
    if (t == 2 || t == 13) {                        // SHORT / YEAR (2 bytes)
        let v = readLE(c, 2);
        return db.dbInt((if (uns) v else signExtend(v, 2)) as int);
    }
    if (t == 3 || t == 9) {                         // LONG / INT24 (4 bytes)
        let v = readLE(c, 4);
        return db.dbLong(if (uns) v else signExtend(v, 4));
    }
    if (t == 8) {                                   // LONGLONG (8 bytes)
        let v = readLE(c, 8);
        return db.dbLong(v);                        // (unsigned > i63 wraps — MySQL edge case)
    }
    if (t == 4) {                                   // FLOAT (4 IEEE bytes)
        let raw = c.take(4);
        return db.dbDouble(string.parseFloat(nova_ieee_le_to_str(raw, 4)));
    }
    if (t == 5) {                                   // DOUBLE (8 IEEE bytes)
        let raw = c.take(8);
        return db.dbDouble(string.parseFloat(nova_ieee_le_to_str(raw, 8)));
    }
    if (t == 0 || t == 246) {                       // DECIMAL / NEWDECIMAL (lenenc text)
        let s = c.lenencStr();
        return DbValue(DbType.Decimal, 0, 0.0, decimal.fromString(s), s);
    }
    if (t == 10 || t == 7 || t == 12) {             // DATE / TIMESTAMP / DATETIME (binary)
        return db.dbTimestamp(decodeBinaryDateTime(c));
    }
    // STRING / VAR_STRING / VARCHAR / BLOB / JSON / etc. -> lenenc string
    return db.dbText(c.lenencStr());
}

// Binary DATE/DATETIME/TIMESTAMP: a lenenc length (0/4/7/11) then year(2) month(1) day(1)
// [hour(1) min(1) sec(1)] [microsec(4)] -> "YYYY-MM-DD HH:MM:SS".
fn decodeBinaryDateTime(c: MyCursor): string {
    let len = c.lenenc();
    if (len == 0) { return "0000-00-00"; }
    let year = c.u16();
    let month = c.byte();
    let day = c.byte();
    let hour = 0; let min = 0; let sec = 0;
    if (len >= 7) { hour = c.byte(); min = c.byte(); sec = c.byte(); }
    let micro = 0;
    if (len >= 11) {
        let m0 = c.byte(); let m1 = c.byte(); let m2 = c.byte(); let m3 = c.byte();
        micro = m0 + m1 * 256 + m2 * 65536 + m3 * 16777216;
    }
    let d = `${year}-${pad2(month)}-${pad2(day)}`;
    if (len < 7) { return d; }
    let t = `${d} ${pad2(hour)}:${pad2(min)}:${pad2(sec)}`;
    if (micro > 0) { return `${t}.${pad6(micro)}`; }   // was dropped -> silent precision loss
    return t;
}
fn pad2(v: int): string { if (v < 10) { return `0${v}`; } return `${v}`; }
fn pad6(v: int): string {
    let s = `${v}`;
    while (s.length < 6) { s = `0${s}`; }
    return s;
}

// A binary-protocol result row: 0x00 header, NULL bitmap ((ncols+9)/8 bytes, offset by 2 bits),
// then a binary value for each non-null column.
pub fn decodeBinaryRow(payload: string, cols: List<Column>, types: List<int>): Row {
    let row = Row();
    let c = MyCursor(payload);
    c.skip(1);                          // 0x00 packet header
    let ncols = cols.size();
    let nbytes = (ncols + 7 + 2) / 8;
    let nullmap = c.take(nbytes);
    let i = 0;
    while (i < ncols) {
        let bitpos = i + 2;
        let nb = bytes.read_byte(nullmap, bitpos / 8);
        let isNull = ((nb / (1 << (bitpos % 8))) % 2) == 1;
        if (isNull) {
            row.cells.push(db.dbNull());
        } else {
            row.cells.push(decodeBinaryCell(c, types.get(i) ?? 253));
        }
        i = i + 1;
    }
    return row;
}

/// ERR packet (first byte 0xff): error_code(u16), sql_state_marker('#')+sql_state(5),
/// error_message(rest).
pub fn decodeErr(payload: string): DbError {
    let c = MyCursor(payload);
    c.skip(1);            // 0xff
    c.u16();              // error code
    let code = "";
    if (c.remaining() > 0 && c.s[c.pos] == 35) {   // '#'
        c.skip(1);
        code = c.take(5);
    }
    let msg = c.take(c.remaining());
    return DbError(code, msg);
}

// An OK packet reports affected_rows (lenenc) + last_insert_id (lenenc). First byte 0x00.
fn okAffectedRows(payload: string): int {
    let c = MyCursor(payload);
    c.skip(1);            // 0x00
    return c.lenenc();
}

// --- Buffered packet reader over a live TCP stream ----------------------------
struct MyReader {
    pub io: aio.AsyncIO,   // A1 async-first: fill awaits io.recvInto (parks, no thread held)
    pub buf: ptr,
    pub cap: int,
    pub len: int,
    pub pos: int,
    init(io: aio.AsyncIO) {
        self.io = io;
        self.cap = 65536;
        self.buf = bytes.alloc(65536);
        self.len = 0;
        self.pos = 0;
    }

    // `buf` is a raw `ptr`, not an ARC-managed field, so ARC won't free it — the
    // destructor must (else the 64KB read buffer leaks per connection). Mirrors
    // BtReader.delete.
    fn delete(self: MyReader): void {
        if (self.buf != 0) {
            bytes.free(self.buf);
            self.buf = 0;
        }
    }
}
async fn fill(r: MyReader): bool {
    if (r.pos > 0) {
        let i = 0;
        while (r.pos + i < r.len) {
            bytes.write_byte(r.buf, i, bytes.read_byte(r.buf, r.pos + i));
            i = i + 1;
        }
        r.len = r.len - r.pos;
        r.pos = 0;
    }
    let space = r.cap - r.len;
    let n = await r.io.recvInto((r.buf + r.len) as int, space);   // parks the coroutine
    if (n <= 0) { return false; }
    r.len = r.len + n;
    return true;
}
async fn need(r: MyReader, k: int): bool {
    while (r.len - r.pos < k) { if (!(await fill(r))) { return false; } }
    return true;
}
fn rbyte(r: MyReader): int { let b = bytes.read_byte(r.buf, r.pos); r.pos = r.pos + 1; return b; }

// A whole MySQL packet payload (header stripped). Returns "" with ok=false at EOF.
struct Packet {
    pub payload: string,
    pub ok: bool,
    pub seq: int,
    init(payload: string, ok: bool) { self.payload = payload; self.ok = ok; self.seq = 0; }
}
async fn readPacket(r: MyReader): Packet {
    if (!(await need(r, 4))) { return Packet("", false); }
    let a = rbyte(r); let b = rbyte(r); let c = rbyte(r);
    let plen = a + b * 256 + c * 65536;
    let seq = rbyte(r);
    if (plen > 0) { if (!(await need(r, plen))) { return Packet("", false); } }
    let out = bytes.alloc(plen);
    let i = 0;
    while (i < plen) { bytes.write_byte(out, i, bytes.read_byte(r.buf, r.pos + i)); i = i + 1; }
    r.pos = r.pos + plen;
    // Bind the `as string` cast to a local so it's registered as an owned temporary —
    // an inline `out as string` as a constructor arg is NOT tracked as owned, so the
    // packet payload leaked (same ARC-edge as the BtReader fix).
    let payload = out as string;
    // T14 Feature 1: multi-packet reassembly. plen == 0xFFFFFF marks a continuation: the logical
    // payload continues in the following packets until one with len < 0xFFFFFF ends the run (which may
    // be a 0-length terminator). Concatenate every continuation body so ALL callers (query/exec/
    // handshake) transparently receive the full logical payload. This mirrors the pure
    // `reassemblePayload` join rule (which the offline gate verifies). NOTE: a single logical chunk is
    // still bounded by the 64KB reader ring (a pre-existing limit, orthogonal to this feature).
    while (plen == MYSQL_MAX_PACKET) {
        if (!(await need(r, 4))) { return Packet("", false); }
        let a2 = rbyte(r); let b2 = rbyte(r); let c2 = rbyte(r);
        plen = a2 + b2 * 256 + c2 * 65536;
        seq = rbyte(r);
        if (plen > 0) { if (!(await need(r, plen))) { return Packet("", false); } }
        let cont = bytes.alloc(plen);
        let j = 0;
        while (j < plen) { bytes.write_byte(cont, j, bytes.read_byte(r.buf, r.pos + j)); j = j + 1; }
        r.pos = r.pos + plen;
        let contStr = cont as string;
        payload = payload + contStr;
    }
    let pk = Packet(payload, true);
    pk.seq = seq;
    return pk;
}

async fn sendPacket(io: aio.AsyncIO, frame: string): int {
    return await io.sendStr(frame);
}

// Is this result packet an end-of-stream EOF? (0xfe first byte, payload < 9 bytes).
fn isEof(p: string): bool { return p.length > 0 && p.length < 9 && p[0] == 254; }
fn isErr(p: string): bool { return p.length > 0 && p[0] == 255; }
fn isOk(p: string): bool { return p.length > 0 && p[0] == 0; }

// --- The seam implementation --------------------------------------------------

pub struct MyConnection impl Connection {
    pub io: aio.AsyncIO,
    pub reader: MyReader,
    pub stmts: List<MyStmt>,   // D6: server-side prepared-statement cache (COM_STMT_*)
    pub busy: bool,   // concurrency guard: one in-flight request per connection
    init(io: aio.AsyncIO, reader: MyReader) {
        self.io = io;
        self.reader = reader;
        self.stmts = List<MyStmt>();
        self.busy = false;
    }

    pub async fn query(self, sql: string, params: List<DbValue>): ResultSet {
        if (self.busy) { return errorResult(DbError("", "connection busy: concurrent use")); }
        self.busy = true;
        await sendPacket(self.io, buildComQuery(substituteParams(sql, params)));
        let rs = ResultSet();
        let first = await readPacket(self.reader);
        if (!first.ok) { rs.err = DbError("", "connection read failed"); self.busy = false; return rs; }
        if (isErr(first.payload)) { rs.err = decodeErr(first.payload); self.busy = false; return rs; }
        if (isOk(first.payload)) { rs.rows_affected = okAffectedRows(first.payload); self.busy = false; return rs; }

        // first.payload = column_count (lenenc).
        let cc = MyCursor(first.payload);
        let ncols = cc.lenenc();
        let i = 0;
        while (i < ncols) {
            let cp = await readPacket(self.reader);
            if (!cp.ok) { self.busy = false; return rs; }
            rs.columns.push(decodeColumnDef(cp.payload));
            i = i + 1;
        }
        // EOF after column defs.
        let eof1 = await readPacket(self.reader);
        // Rows until EOF (an ERR here is a mid-result failure -- surface it).
        while (true) {
            let rp = await readPacket(self.reader);
            if (!rp.ok) { break; }
            if (isErr(rp.payload)) { rs.err = decodeErr(rp.payload); break; }
            if (isEof(rp.payload)) { break; }
            rs.rows.push(decodeTextRow(rp.payload, rs.columns));
        }
        rs.rows_affected = rs.rows.size();
        rs.tag = `SELECT ${rs.rows.size()}`;
        self.busy = false;
        return rs;
    }

    pub async fn exec(self, sql: string, params: List<DbValue>): ExecResult {
        if (self.busy) { return errorExec(DbError("", "connection busy: concurrent use")); }
        self.busy = true;
        await sendPacket(self.io, buildComQuery(substituteParams(sql, params)));
        let p = await readPacket(self.reader);
        if (!p.ok) { self.busy = false; return errorExec(DbError("", "connection read failed")); }
        if (isErr(p.payload)) { self.busy = false; return errorExec(decodeErr(p.payload)); }
        if (isOk(p.payload)) { self.busy = false; return ExecResult(okAffectedRows(p.payload), "OK"); }
        // A result set slipped through (SELECT via exec); drain to ReadyForQuery-equivalent.
        self.busy = false;
        return ExecResult(0, "OK");
    }

    pub fn close(self): void {
        // sync trait method: close the socket (a graceful COM_QUIT would need an async send;
        // an abrupt close is fine for teardown).
        self.io.close();
    }

    // Transaction control (BEGIN is a MySQL alias for START TRANSACTION).
    pub async fn begin(self): ExecResult { return await self.exec("BEGIN", List<DbValue>()); }
    pub async fn commit(self): ExecResult { return await self.exec("COMMIT", List<DbValue>()); }
    pub async fn rollback(self): ExecResult { return await self.exec("ROLLBACK", List<DbValue>()); }

    pub fn setTimeout(self, ms: int): int {   // D6 — async per-recv awaited deadline
        return self.io.setTimeout(ms);
    }

    // D6 prepared statements — REAL server-side (COM_STMT_PREPARE / COM_STMT_EXECUTE, binary
    // protocol). `prepare` parses the SQL once server-side and caches its id + result-column
    // metadata (deduped by SQL); `queryPrepared`/`execPrepared` bind params + run it.
    pub async fn prepare(self, sql: string): int {
        let d = 0;
        while (d < self.stmts.size()) {
            let s = self.stmts.get(d) ?? MyStmt(0, "", List<Column>(), List<int>(), 0);
            if (string.eql(s.sql, sql)) { return d; }
            d = d + 1;
        }
        await sendPacket(self.io, buildStmtPrepare(sql));
        let ok = await readPacket(self.reader);
        // COM_STMT_PREPARE_OK: 0x00, stmt_id(4), num_columns(2), num_params(2), 0x00, warnings(2).
        if (!ok.ok || isErr(ok.payload)) { return -1; }
        let oc = MyCursor(ok.payload);
        oc.skip(1);
        let stmtId = oc.u32();
        let numCols = oc.u16();
        let numParams = oc.u16();
        // Param definition packets (numParams) + EOF, then column defs (numCols) + EOF. This
        // build does not set CLIENT_DEPRECATE_EOF, so the EOF packets are present.
        let pi = 0;
        while (pi < numParams) { let pp = await readPacket(self.reader); pi = pi + 1; }
        if (numParams > 0) { let e1 = await readPacket(self.reader); }
        let cols = List<Column>();
        let colTypes = List<int>();
        let ci = 0;
        while (ci < numCols) {
            let cp = await readPacket(self.reader);
            cols.push(decodeColumnDef(cp.payload));
            colTypes.push(columnTypeRaw(cp.payload));
            ci = ci + 1;
        }
        if (numCols > 0) { let e2 = await readPacket(self.reader); }
        let idx = self.stmts.size();
        self.stmts.push(MyStmt(stmtId, sql, cols, colTypes, numParams));
        return idx;
    }

    pub async fn queryPrepared(self, stmt: int, params: List<DbValue>): ResultSet {
        if (self.busy) { return errorResult(DbError("", "connection busy: concurrent use")); }
        self.busy = true;
        let rs = ResultSet();
        if (stmt < 0 || stmt >= self.stmts.size()) { self.busy = false; return rs; }
        let s = self.stmts.get(stmt) ?? MyStmt(0, "", List<Column>(), List<int>(), 0);
        await sendPacket(self.io, buildStmtExecute(s.id, params));
        let first = await readPacket(self.reader);
        if (!first.ok) { rs.err = DbError("", "connection read failed"); self.busy = false; return rs; }
        if (isErr(first.payload)) { rs.err = decodeErr(first.payload); self.busy = false; return rs; }
        if (isOk(first.payload)) { rs.rows_affected = okAffectedRows(first.payload); self.busy = false; return rs; }
        // column_count(lenenc), then column defs + EOF, then BINARY rows until EOF.
        let cc = MyCursor(first.payload);
        let ncols = cc.lenenc();
        let cols = List<Column>();
        let colTypes = List<int>();
        let i = 0;
        while (i < ncols) {
            let cp = await readPacket(self.reader);
            cols.push(decodeColumnDef(cp.payload));
            colTypes.push(columnTypeRaw(cp.payload));
            i = i + 1;
        }
        rs.columns = cols;
        let eof1 = await readPacket(self.reader);
        while (true) {
            let rp = await readPacket(self.reader);
            if (!rp.ok) { break; }
            if (isErr(rp.payload)) { rs.err = decodeErr(rp.payload); break; }
            if (isEof(rp.payload)) { break; }
            rs.rows.push(decodeBinaryRow(rp.payload, rs.columns, colTypes));
        }
        rs.rows_affected = rs.rows.size();
        rs.tag = `SELECT ${rs.rows.size()}`;
        self.busy = false;
        return rs;
    }

    pub async fn execPrepared(self, stmt: int, params: List<DbValue>): ExecResult {
        if (self.busy) { return errorExec(DbError("", "connection busy: concurrent use")); }
        self.busy = true;
        if (stmt < 0 || stmt >= self.stmts.size()) { self.busy = false; return ExecResult(0, ""); }
        let s = self.stmts.get(stmt) ?? MyStmt(0, "", List<Column>(), List<int>(), 0);
        await sendPacket(self.io, buildStmtExecute(s.id, params));
        let p = await readPacket(self.reader);
        if (!p.ok) { self.busy = false; return errorExec(DbError("", "connection read failed")); }
        if (isErr(p.payload)) { self.busy = false; return errorExec(decodeErr(p.payload)); }
        if (isOk(p.payload)) { self.busy = false; return ExecResult(okAffectedRows(p.payload), "OK"); }
        // A result set (SELECT via execPrepared): drain column defs + rows to keep the stream aligned.
        let cc = MyCursor(p.payload);
        let ncols = cc.lenenc();
        let i = 0;
        while (i < ncols) { let cp = await readPacket(self.reader); i = i + 1; }
        let eof1 = await readPacket(self.reader);
        let derr = noError();
        while (true) {
            let rp = await readPacket(self.reader);
            if (!rp.ok) { break; }
            if (isErr(rp.payload)) { derr = decodeErr(rp.payload); break; }
            if (isEof(rp.payload)) { break; }
        }
        if (!derr.isEmpty()) { self.busy = false; return errorExec(derr); }
        self.busy = false;
        return ExecResult(0, "OK");
    }
}

fn escapeText(s: string): string {
    let out = "'";
    let i = 0;
    let n = s.length;
    while (i < n) {
        let ch = s[i];
        if (ch == 39) { out = out + "''"; }        // ' -> ''
        else if (ch == 92) { out = out + "\\\\"; } // \ -> \\  (MySQL backslash escaping)
        else { out = out + string.slice(s, i, i + 1); }
        i = i + 1;
    }
    return out + "'";
}
// MySQL binary literal x'HEX' -- binary-safe (NUL/quotes), unlike text-escaping raw bytes.
fn mysqlBlobLiteral(s: string): string {
    let out = "x'";
    let i = 0;
    while (i < s.length) {
        let b = s[i];
        out = out + myHexDigit((b / 16) & 15) + myHexDigit(b & 15);
        i = i + 1;
    }
    return out + "'";
}
fn myHexDigit(v: int): string {
    if (v < 10) { return string.slice("0123456789", v, v + 1); }
    return string.slice("abcdef", v - 10, v - 10 + 1);
}
fn valueToSql(v: DbValue): string {
    if (v.isNull()) { return "NULL"; }
    if (v.kind == DbType.Bool) { if (v.asBool()) { return "1"; } return "0"; }
    if (v.kind == DbType.Blob) { return mysqlBlobLiteral(v.asText()); }
    if (v.kind == DbType.Text) { return escapeText(v.asText()); }
    if (v.kind == DbType.Decimal) { return v.asText(); }
    if (v.kind == DbType.Float4 || v.kind == DbType.Float8) { let d = v.asDouble(); return `${d}`; }
    let iv = v.asLong();
    return `${iv}`;
}
pub fn substituteParams(sql: string, params: List<DbValue>): string {
    let out = "";
    let i = 0;
    let n = sql.length;
    while (i < n) {
        // '$' + one or more digits -> parameter N (1-based). Multi-digit required for >9-column ORM inserts.
        if (sql[i] == 36 && i + 1 < n && sql[i + 1] >= 48 && sql[i + 1] <= 57) {
            let j = i + 1;
            let num = 0;
            while (j < n && sql[j] >= 48 && sql[j] <= 57) { num = num * 10 + (sql[j] - 48); j = j + 1; }
            let p = params.get(num - 1) ?? db.dbNull();
            out = out + valueToSql(p);
            i = j;
        } else {
            out = out + string.slice(sql, i, i + 1);
            i = i + 1;
        }
    }
    return out;
}

/// The MySQL driver. DSN: `mysql://user[:password]@host[:port]/database`. Reads the server
/// Handshake, computes the auth response (native_password SHA1, or caching_sha2 fast SHA256),
/// sends HandshakeResponse41, and expects an OK packet.
// Whole connect + auth handshake as ONE async fn, driven once by the sync Driver.connect.
async fn myConnectAsync(dsn: string): MyConnection {
        let d = parseDsn(dsn);
        let stream = await aio.asyncConnect(d.host, d.port);
        let reader = MyReader(stream);

        let hp = await readPacket(reader);
        let hs = parseHandshake(hp.payload);

        // Compute the scramble for the server's chosen auth plugin. An EMPTY password
        // MUST send an empty scramble (a 0-length auth response) — the server then
        // fast-accepts an empty-password account; a computed 32-byte scramble would
        // fail auth.
        let scramble = "";
        if (d.password.length > 0) {
            if (string.eql(hs.plugin, "caching_sha2_password")) {
                scramble = mysqlSha2Scramble(d.password, hs.salt);
            } else {
                scramble = mysqlNativeScramble(d.password, hs.salt);
            }
        }

        // STARTTLS: when sslmode is set, run TLS between the server Handshake and the
        // HandshakeResponse. SSLRequest = the first 32 bytes of the response with CLIENT_SSL set (seq 1);
        // then the socket is upgraded and the full response is sent over TLS (seq 2). Passing the
        // concrete stream into myAuthFinish's AsyncIO param is a widening (the safe direction).
        if (string.eql(d.sslmode, "disable")) {
            await sendPacket(stream, buildHandshakeResponse(d.user, d.database, scramble, hs.plugin));
            return await myAuthFinish(stream, reader, d, hs.salt);
        }
        let sslCaps = clientCapabilities() + CLIENT_SSL;
        await sendPacket(stream, buildSSLRequest(sslCaps, hp.seq + 1));
        if (string.eql(d.sslmode, "verify-full")) {
            let caPem = if (d.sslrootcert != "") File.readText(d.sslrootcert) else "";
            let ts = await asynctls.tlsClientUpgradeVerify(stream, d.host, caPem);
            reader.io = ts;
            await sendPacket(ts, buildHandshakeResponseFull(d.user, d.database, scramble, hs.plugin, sslCaps, hp.seq + 2));
            return await myAuthFinish(ts, reader, d, hs.salt);
        }
        let ts2 = await asynctls.tlsClientUpgrade(stream, d.host);
        reader.io = ts2;
        await sendPacket(ts2, buildHandshakeResponseFull(d.user, d.database, scramble, hs.plugin, sslCaps, hp.seq + 2));
        return await myAuthFinish(ts2, reader, d, hs.salt);
}

// The post-response auth flow (auth-result, AuthSwitch, caching_sha2 full-auth) over `io` (plaintext
// AsyncStream or an upgraded TlsStream, both AsyncIO). `reader` reads the responses; its transport was
// pointed at `io` by the caller before the TLS path invoked this.
async fn myAuthFinish(io: aio.AsyncIO, reader: MyReader, d: MyDsn, initSalt: string): MyConnection {
        // `activeSalt` is the nonce the current auth response was computed against — the RSA full-auth
        // path XORs the password with it, so it must track any AuthSwitch.
        let activeSalt = initSalt;
        let ar = await readPacket(reader);

        // AuthSwitchRequest (0xfe): the server names the plugin it wants + a fresh 20-byte salt;
        // re-scramble against THAT and reply (seq+1). MySQL 8/9 sends this for caching_sha2_password.
        if (ar.payload.length > 0 && bytes.read_byte(ar.payload, 0) == 254) {
            let sc = MyCursor(ar.payload);
            sc.skip(1);
            let swPlugin = sc.cstr();
            let swSalt = sc.take(20);
            activeSalt = swSalt;
            let sw = "";
            if (d.password.length > 0) {
                if (string.eql(swPlugin, "caching_sha2_password")) {
                    sw = mysqlSha2Scramble(d.password, swSalt);
                } else {
                    sw = mysqlNativeScramble(d.password, swSalt);
                }
            }
            await sendPacket(io, packet(ar.seq + 1, sw));
            ar = await readPacket(reader);
        }

        // caching_sha2 AuthMoreData (0x01): byte[1] selects the sub-path.
        //   0x03 = fast-auth success -> the real OK follows.
        //   0x04 = full auth required. Over TLS the password could go in cleartext, but sending the
        //          RSA-encrypted password works on both transports, so keep the one path.
        if (ar.payload.length > 1 && bytes.read_byte(ar.payload, 0) == 1) {
            let more = bytes.read_byte(ar.payload, 1);
            if (more == 4) {
                await sendPacket(io, packet(ar.seq + 1, u8b(2)));   // 0x02: request RSA public key
                let pk = await readPacket(reader);                   // AuthMoreData(0x01) + PEM
                let pem = string.slice(pk.payload, 1, pk.payload.length);
                let enc = rsaEncryptPassword(d.password, activeSalt, pem);
                await sendPacket(io, packet(pk.seq + 1, enc));
                let ok = await readPacket(reader);                   // OK (or ERR)
            } else {
                let after = await readPacket(reader);                // 0x03 fast success -> real OK
            }
        }
        return MyConnection(io, reader);
}

pub struct MyDriver impl Driver {
    pub async fn connect(self, dsn: string): Connection {
        return await myConnectAsync(dsn);   // sync trait method drives the async connect once
    }
}

struct MyDsn {
    pub host: string,
    pub port: int,
    pub user: string,
    pub password: string,
    pub database: string,
    pub sslmode: string,       // "disable" (default) | "require" | "verify-full"
    pub sslrootcert: string,   // PEM CA bundle path (verify-full)
    init(host: string, port: int, user: string, password: string, database: string, sslmode: string, sslrootcert: string) {
        self.host = host; self.port = port; self.user = user;
        self.password = password; self.database = database;
        self.sslmode = sslmode; self.sslrootcert = sslrootcert;
    }
}
// Pull `key=value` out of a `?a=b&c=d` DSN query string (returns `dflt` if absent).
fn dsnParam(dsn: string, key: string, dflt: string): string {
    let needle = key + "=";
    let idx = string.indexOf(dsn, needle);
    if (idx == -1) { return dflt; }
    let rest = string.slice(dsn, idx + needle.length, dsn.length);
    let amp = string.indexOf(rest, "&");
    if (amp == -1) { return rest; }
    return string.slice(rest, 0, amp);
}
fn parseDsn(dsn: string): MyDsn {
    let sslmode = dsnParam(dsn, "sslmode", "disable");
    let sslrootcert = dsnParam(dsn, "sslrootcert", "");

    let s = dsn;
    let scheme = string.indexOf(s, "://");
    if (scheme != -1) { s = string.slice(s, scheme + 3, s.length); }
    let qq = string.indexOf(s, "?");
    if (qq != -1) { s = string.slice(s, 0, qq); }

    let user = "root";
    let password = "";
    let at = string.lastIndexOf(s, "@");
    if (at != -1) {
        let cred = string.slice(s, 0, at);
        s = string.slice(s, at + 1, s.length);
        let colon = string.indexOf(cred, ":");
        if (colon == -1) { user = cred; }
        else { user = string.slice(cred, 0, colon); password = string.slice(cred, colon + 1, cred.length); }
    }
    let database = "";
    let slash = string.indexOf(s, "/");
    if (slash != -1) {
        database = string.slice(s, slash + 1, s.length);
        s = string.slice(s, 0, slash);
    }
    let host = s;
    let port = 3306;
    let pc = string.lastIndexOf(s, ":");
    if (pc != -1) {
        host = string.slice(s, 0, pc);
        port = string.parseI64(string.slice(s, pc + 1, s.length));
    }
    return MyDsn(host, port, user, password, database, sslmode, sslrootcert);
}
